{
  "name": "tunibots",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server/index.ts",
    "start": "tsx server/index.ts",
    "build": "tsc && vite build",
    "test": "tsx tests/run-vitest.ts",
    "test:watch": "tsx tests/run-vitest.ts watch",
    "test:db:reset": "tsx tests/run-prisma-command.ts migrate reset --force --skip-seed --schema server/schema.prisma",
    "test:db:generate": "tsx tests/run-prisma-command.ts generate --schema server/schema.prisma",
    "test:seed:orders": "tsx tests/seed-large-orders.ts",
    "test:notifications": "tsx tests/notifications.integration.ts",
    "images:audit": "tsx scripts/audit-inline-images.ts",
    "images:migrate": "tsx scripts/migrate-inline-images.ts",
    "db:seed": "tsx server/seed.ts",
    "db:generate": "prisma generate --schema server/schema.prisma",
    "db:migrate": "prisma migrate deploy --schema server/schema.prisma",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview"
  },
  "dependencies": {
    "@google/genai": "^1.47.0",
    "@prisma/client": "^5.22.0",
    "@sentry/node": "^10.63.0",
    "@sentry/react": "^10.63.0",
    "@tanstack/react-query": "^5.101.2",
    "@types/multer": "^2.2.0",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.0",
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.2",
    "helmet": "^8.2.0",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^0.344.0",
    "multer": "^2.2.0",
    "nodemailer": "^8.0.4",
    "pdfkit": "^0.19.1",
    "pino": "^10.3.1",
    "prisma": "^5.22.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^6.30.4",
    "recharts": "^2.12.2",
    "remark-gfm": "^4.0.1",
    "sharp": "^0.35.3",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "tailwind-merge": "^2.2.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/pdfkit": "^0.17.6",
    "@types/react": "^18.2.64",
    "@types/react-dom": "^18.2.21",
    "@types/supertest": "^7.2.0",
    "@typescript-eslint/eslint-plugin": "^8.58.0",
    "@typescript-eslint/parser": "^8.58.0",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.18",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "postcss": "^8.4.35",
    "supertest": "^7.2.2",
    "tailwindcss": "^3.4.1",
    "tsx": "^4.21.0",
    "typescript": "^5.2.2",
    "typescript-eslint": "^8.58.0",
    "vite": "^5.1.6",
    "vitest": "^4.1.9"
  }
}
